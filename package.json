{
  "name": "av2-catalogo-jogos",
  "version": "1.0.0",
  "description": "API REST de catálogo de jogos com autenticação, upload e Swagger",
  "main": "server.js",
  "scripts": {
    "setup": "node scripts/setup.js",
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:generate": "prisma generate --schema=./prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema=./prisma/schema.prisma",
    "db:studio": "prisma studio --schema=./prisma/schema.prisma",
    "test": "node --test"
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "keywords": [
    "express",
    "api",
    "jogos",
    "swagger",
    "bcrypt"
  ],
  "author": "Pedro Anjos",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcrypt": "^6.0.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "prisma": "^6.19.3"
  }
}
